<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.radiology</package>
	<author>Dipak Thapa</author>
	<description>
		${project.parent.description}
	</description>

	<activator>org.openmrs.module.radiology.RadiologyModuleActivator</activator>

	<require_version>2.6.* - 2.9.*</require_version>

	<require_modules>
		<require_module>org.openmrs.module.webservices.rest</require_module>
	</require_modules>

	<globalProperty>
		<property>radiology.enablePacsIntegration</property>
		<defaultValue>true</defaultValue>
		<description>Enable/disable direct PACS integration. When disabled, middleware handles modality requests instead of OpenMRS.</description>
	</globalProperty>

	<advice>
		<point>org.openmrs.api.OrderService</point>
		<class>${project.parent.groupId}.${project.parent.artifactId}.api.advice.RadiologyOrderCreateBeforeAdvice</class>
	</advice>

	<advice>
		<point>org.openmrs.api.OrderService</point>
		<class>${project.parent.groupId}.${project.parent.artifactId}.api.advice.RadiologyOrderCreateAfterAdvice</class>
	</advice>


	<!-- Maps hibernate files, if present -->
	<mappingFiles>
		RadiologyOrder.hbm.xml
	</mappingFiles>

	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>fr</lang>
		<file>messages_fr.properties</file>
	</messages>
	<messages>
		<lang>es</lang>
		<file>messages_es.properties</file>
	</messages>
	<!-- /Internationalization -->

</module>
